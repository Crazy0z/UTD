local function loadLibrary(url)
    local urls = {
        url,
        url:gsub("joustingmatch/ObsidianUltra", "Crazy0z/Obsidian"),
        url:gsub("joustingmatch/ObsidianUltra", "violin-suzutsuki/LinoriaLib"),
    }
    for _, u in ipairs(urls) do
        local ok, src = pcall(function() return game:HttpGet(u, true) end)
        if ok and type(src) == "string" and #src > 100 then
            local fn = loadstring(src)
            if fn then
                local ran, mod = pcall(fn)
                if ran and mod then return mod end
            end
        end
    end
    return nil
end

