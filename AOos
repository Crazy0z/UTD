local IsProcessing = false
local MobileGui = nil

local function CalculateGrid(center, count, spacing)
    local positions = table.create(count)
    local cols = math.ceil(math.sqrt(count))
    local half = (cols - 1) * spacing * 0.5

    for i = 0, count - 1 do
        local col = i % cols
        local row = math.floor(i / cols)
        local posX = center.X + (col * spacing) - half
        local posZ = center.Z + (row * spacing) - half
        positions[i + 1] = Vector3.new(posX, center.Y, posZ)
    end
    return positions
end

local function GetTargetPosition()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        return root.Position
    end
    return Vector3.new(0, 0, 0)
end

local function DeployTowers()
    if not TowerRemote or IsProcessing then return end
    IsProcessing = true

    local slot = Options.SelectTowerSlot and Options.SelectTowerSlot.Value or "Tower1"
    local count = Options.PlacementAmount and tonumber(Options.PlacementAmount.Value) or 10
    local spacing = Options.PlacementSpacing and tonumber(Options.PlacementSpacing.Value) or 4
    local delayTime = Options.PlacementDelay and tonumber(Options.PlacementDelay.Value) or 0.05

    local targetPos = GetTargetPosition()
    local positions = CalculateGrid(targetPos, count, spacing)
    local normal = Vector3.new(0, 1, 0)

    task.spawn(function()
        for i = 1, #positions do
            pcall(function()
                TowerRemote:InvokeServer(
                    "PlaceTower",
                    slot,
                    positions[i],
                    normal,
                    0,
                    nil,
                    false
                )
            end)
            if delayTime > 0 then
                task.wait(delayTime)
            end
        end
        IsProcessing = false
    end)
end

local function ClaimPlayTimeRewards()
    if not PlayTimeRemote then return end
    task.spawn(function()
        for i = 1, 6 do
            pcall(function()
                PlayTimeRemote:FireServer("ClaimPlayTimeReward", i)
            end)
            task.wait(0.1)
        end
    end)
end

local function ToggleMobileButton(enable)
    if MobileGui then
        MobileGui:Destroy()
        MobileGui = nil
    end

    if not enable then return end

    local parentGui = pcall(function() return CoreGui end) and CoreGui or LocalPlayer:WaitForChild("PlayerGui")
    MobileGui = Instance.new("ScreenGui")
    MobileGui.Name = "CrazyHub_MobileDeploy"
    MobileGui.ResetOnSpawn = false
    MobileGui.Parent = parentGui

    local btn = Instance.new("TextButton")
    btn.Name = "DeployButton"
    btn.Size = UDim2.new(0, 110, 0, 42)
    btn.Position = UDim2.new(0.85, -55, 0.7, 0)
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    btn.BorderColor3 = Color3.fromRGB(45, 45, 55)
    btn.BorderSizePixel = 1
    btn.Text = "DEPLOY"
    btn.TextColor3 = Color3.fromRGB(220, 220, 230)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Active = true
    btn.Draggable = true
    btn.Parent = MobileGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(85, 95, 230)
    stroke.Parent = btn

    btn.MouseButton1Click:Connect(function()
        DeployTowers()
    end)
end

